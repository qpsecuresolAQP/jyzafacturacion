# ── VidaPlus — Variables de entorno Docker ─────────────────────────────────────
# Copia este archivo como .env y rellena los valores antes de hacer docker compose up

# ── DEBUG ──────────────────────────────────────────────────────────────────────────
DEBUG=false

# ── APP PORT (Apache en contenedor) ─────────────────────────────────────────────────
APP_PORT=8092

# ── DATABASE CONFIG ────────────────────────────────────────────────────────────────────
DB_HOST=db
DB_PORT=3307
DB_NAME=vidaplus
DB_USERNAME=vidaplus
DB_PASSWORD=CAMBIA_ESTA_CLAVE_APP
DB_ROOT_PASSWORD=CAMBIA_ESTA_CLAVE_ROOT

# ── DOMAIN & SSL (para nginx + Certbot) ────────────────────────────────────────────────
# IP pública del VPS (ejecuta: curl -s http://icanhazip.com)
VHOST_IP=123.45.67.89
# Dominio principal (ej. midominio.com, pedraza.com)
VHOST_DOMAIN=midominio.com
# Subdominio (ej. pedraza, app, etc)
VHOST_SUBDOMAIN=pedraza
# URL completa (generada automáticamente)
VHOST_FULL=pedraza.midominio.com

# ── CAKEPHP SECURITY ───────────────────────────────────────────────────────────────────
# Genera uno con: php -r "echo bin2hex(random_bytes(32));"
SECURITY_SALT=GENERA_UN_SALT_ALEATORIO_DE_64_CARACTERES_HEX

# ── PERUAPI CONFIG ────────────────────────────────────────────────────────────────────
PERUAPI_BASE_URL=https://peruapi.com/api
PERUAPI_KEY=
